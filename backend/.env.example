# =================================================================
# AADHIRAI Backend Environment Configuration Example
# =================================================================

# Server
PORT=5000
NODE_ENV=development
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB Persistent Storage
MONGODB_URI=mongodb://127.0.0.1:27017/aadhirai
MONGODB_DB=aadhirai

# Authentication (JWT)
SECRET_KEY=aadhirai-super-secret-jwt-key-2026-tamiltight-production
JWT_SECRET=aadhirai-super-secret-jwt-key-2026-tamiltight-production
JWT_EXPIRES_IN=24h

# ML Vision Service Integration (Hugging Face YOLO11m + Google Gemini Vision)
ML_SERVICE_URL=http://127.0.0.1:8001
AI_REQUEST_TIMEOUT=30
MAX_IMAGE_SIZE_MB=10

# Google Gemini Vision API (Multimodal AI)
# Provide your official Google Gemini API Key below
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Repository & Token (Optional for public model Aryansahay/Pothole)
HF_MODEL_REPO=Aryansahay/Pothole
HF_TOKEN=

# Upload Storage
UPLOAD_DIR=./uploads
STORAGE_DIR=./storage_uploads
PUBLIC_BASE_URL=http://localhost:3000
