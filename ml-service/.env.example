# =================================================================
# AADHIRAI ML Vision Service Configuration Example
# =================================================================

ML_PORT=8001
MAX_IMAGE_SIZE_MB=10

# Hugging Face Computer Vision Model
# Repository: Aryansahay/Pothole
# Model: CivicAi-YOLO11m-v1 (Weights: Vision Classification.pt)
HF_MODEL_REPO=Aryansahay/Pothole
HF_TOKEN=

# Google Gemini Vision API (Multimodal AI)
# Provide your official Google Gemini API Key below
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Inference Settings
YOLO_CONF_THRESHOLD=0.15
YOLO_IMG_SIZE=768
